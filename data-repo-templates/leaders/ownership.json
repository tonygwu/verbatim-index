{
 "schema": 1,
 "study": "leaders",
 "note": "Who may change which paths in tonygwu/verbatim-index-data when pushing main. The first matching rule wins, so specific rules come before general ones. owner: only a checkout with verbatim.role=daemon (the daemons write these uncommitted, so another clone touching them would collide with a running loop). shared: any contributor clone. derived: any contributor clone, but only as a regenerated, fresh file. An unlisted path is refused. Enforced by scripts/data_sync.py and the pre-push hook; see docs/plans/shared-data-push-2026-09-27.md.",
 "rules": [
  {"glob": "ownership.json", "class": "owner"},
  {"glob": ".gitattributes", "class": "owner"},
  {"glob": ".gitignore", "class": "owner"},
  {"glob": "predictions/index.json", "class": "derived", "by": "aggregate_predictions"},
  {"glob": "predictions/scores.json", "class": "derived", "by": "score_predictions --config"},
  {"glob": "predictions/**", "class": "shared"},
  {"glob": "transcripts_web/**", "class": "shared"},
  {"glob": "experiments/**", "class": "shared"},
  {"glob": "transcripts/**", "class": "owner"},
  {"glob": "transcripts_open/**", "class": "owner"},
  {"glob": "transcripts_blind/**", "class": "owner"},
  {"glob": "transcripts_hs/**", "class": "owner"},
  {"glob": "grades/**", "class": "owner"},
  {"glob": "speaker_turns/**", "class": "owner"},
  {"glob": "logs/**", "class": "owner"},
  {"glob": "sources/**", "class": "owner"},
  {"glob": "roster/**", "class": "owner"},
  {"glob": "results.json", "class": "owner"},
  {"glob": "results_audit.json", "class": "owner"},
  {"glob": "results_smoke.json", "class": "owner"},
  {"glob": "results_smoke_audit.json", "class": "owner"},
  {"glob": "fixture_meta/**", "class": "owner"},
  {"glob": "fixtures/**", "class": "owner"},
  {"glob": "fixtures_clean/**", "class": "owner"},
  {"glob": "fixtures_padded/**", "class": "owner"},
  {"glob": "grades_probe/**", "class": "owner"},
  {"glob": "grades_retest/**", "class": "owner"},
  {"glob": "grades_smoke/**", "class": "owner"},
  {"glob": "retest_subset/**", "class": "owner"}
 ]
}
