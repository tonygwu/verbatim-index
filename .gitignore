.venv/
__pycache__/
*.pyc
*.superseded
*.orphaned

# Private data symlink or directory. No trailing slash: Git treats a symlink
# as a file. Independent preparation checkouts are ignored separately below.
/data

# Build artifact, rendered from data/results.json by scripts/build_site.py and
# published through scripts/deploy.sh with an explicit production source/revision.
site/index.html

# Wrangler's local cache carries the Cloudflare account id.
.wrangler/

# Build artifact of build_predictions_site.py, deployed from disk like site/index.html.
site-predictions/index.html

# Independent private clones, including incomplete migration preparations.
/.data-clones/

# The pundits study's private data link, and its site build artifact.
/data-pundits
site-pundits/index.html

# Build artifacts: each leader's evidence and each person's prediction records,
# written beside the pages by build_site.py and build_predictions_site.py and
# uploaded by wrangler. Data, so never committed here.
site/audit/
site-predictions/predictions/
